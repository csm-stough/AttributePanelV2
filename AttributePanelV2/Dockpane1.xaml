<UserControl x:Class="AttributePanelV2.Dockpane1View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"   
             xmlns:ui="clr-namespace:AttributePanelV2"
             xmlns:extensions="clr-namespace:ArcGIS.Desktop.Extensions;assembly=ArcGIS.Desktop.Extensions"
             xmlns:controls="clr-namespace:ArcGIS.Desktop.Framework.Controls;assembly=ArcGIS.Desktop.Framework"                       
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             d:DataContext="{Binding Path=ui.Dockpane1ViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <extensions:DesignOnlyResourceDictionary Source="pack://application:,,,/ArcGIS.Desktop.Framework;component\Themes\Default.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Attribute Type Converters -->
            <ui:DomainValueConverter x:Key="DomainValueConverter"/>
            <ui:DoubleValueConverter x:Key="DoubleValueConverter"/>
            <ui:IntegerValueConverter x:Key="IntegerValueConverter"/>
            <ui:SmallIntegerValueConverter x:Key="SmallIntegerValueConverter"/>
            <ui:BigIntegerValueConverter x:Key="BigIntegerValueConverter"/>

            <!-- Data Templates for Attribute Types -->
            <DataTemplate x:Key="StringAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Text="{Binding CurrentValue, Mode=TwoWay}"
                        MaxLength="{Binding Length}"
                        IsEnabled="{Binding IsEditable}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CodedValueAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <ComboBox
                        Grid.Column="1"
                        SelectedValue="{Binding CurrentValue, Mode=TwoWay}" 
                        ItemsSource="{Binding DomainValues}"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Code"
                        IsEnabled="{Binding IsEditable}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="DoubleAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Text="{Binding CurrentValue, Mode=TwoWay, Converter={StaticResource DoubleValueConverter}}"
                        IsEnabled="{Binding IsEditable}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="IntegerAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Text="{Binding CurrentValue, Mode=TwoWay, Converter={StaticResource IntegerValueConverter}}"
                        IsEnabled="{Binding IsEditable}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SmallIntegerAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Text="{Binding CurrentValue, Mode=TwoWay, Converter={StaticResource SmallIntegerValueConverter}}"
                        IsEnabled="{Binding IsEditable}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="BigIntegerAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBox
                        Grid.Column="1"
                        Text="{Binding CurrentValue, Mode=TwoWay, Converter={StaticResource BigIntegerValueConverter}}"
                        IsEnabled="{Binding IsEditable}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OIDAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding CurrentValue}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GeometryAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding CurrentValue}"
                    />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="GUIDAttributeTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding Alias}"
                        VerticalAlignment="Center"/>
                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding CurrentValue}"
                    />
                </Grid>
            </DataTemplate>

            <!-- Attribute Template Selector -->

            <ui:AttributeTemplateSelector x:Key="AttributeTemplateSelector"
                    StringTemplate="{StaticResource StringAttributeTemplate}"
                    CodedValueTemplate="{StaticResource CodedValueAttributeTemplate}"
                    DoubleTemplate="{StaticResource DoubleAttributeTemplate}"
                    IntegerTemplate="{StaticResource IntegerAttributeTemplate}"
                    SmallIntegerTemplate="{StaticResource SmallIntegerAttributeTemplate}"
                    BigIntegerTemplate="{StaticResource BigIntegerAttributeTemplate}"
                    OIDTemplate="{StaticResource OIDAttributeTemplate}"
                    GeometryTemplate="{StaticResource GeometryAttributeTemplate}"
                    GUIDTemplate="{StaticResource GUIDAttributeTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="true" KeyboardNavigation.TabNavigation="Local" Height="30">
        </DockPanel>
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- DockPane Header -->
            <DockPanel Grid.Row="0"
               LastChildFill="true"
               KeyboardNavigation.TabNavigation="Local"
               Height="30">
            </DockPanel>


            <!-- Actual Content -->
            <StackPanel Grid.Row="1"
                Margin="10">

                <ItemsControl 
                    ItemsSource="{Binding Attributes}"
                    ItemTemplateSelector="{StaticResource AttributeTemplateSelector}">
                </ItemsControl>
                <Button Content="Apply" 
                    Width="100" 
                    Height="30" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Command="{Binding ApplyCommand}"/>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>