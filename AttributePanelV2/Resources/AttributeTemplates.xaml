<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ui="clr-namespace:AttributePanelV2"
	xmlns:converters="clr-namespace:AttributePanelV2.Converters">

	<!-- Attribute Type Converters -->
	<converters:DomainValueConverter x:Key="DomainValueConverter"/>
	<converters:DoubleValueConverter x:Key="DoubleValueConverter"/>
	<converters:SingleValueConverter x:Key="SingleValueConverter"/>
	<converters:IntegerValueConverter x:Key="IntegerValueConverter"/>
	<converters:SmallIntegerValueConverter x:Key="SmallIntegerValueConverter"/>
	<converters:BigIntegerValueConverter x:Key="BigIntegerValueConverter"/>
	<converters:GeometryThumbnailConverter x:Key="GeometryThumbnailConverter"/>
	<converters:VariesKeyToIsEnabledConverter x:Key="VariesKeyToIsEnabledConverter"/>

	<DataTemplate x:Key="StringAttributeTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Dirty Indicator -->
            <TextBlock
                Grid.Column="0"
                Text="●"
                HorizontalAlignment="Center">

                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Attribute Name -->
            <TextBlock
                Grid.Column="1"
                Text="{Binding Alias}"
                VerticalAlignment="Center"/>
            <!-- Attribute Value -->
            <TextBox
                Grid.Column="2"
                Text="{Binding CurrentValue, Mode=TwoWay, TargetNullValue=&lt;Null&gt;}"
                MaxLength="{Binding Length}"
                IsEnabled="{Binding IsEditable}"
            />
        </Grid>
    </DataTemplate>

