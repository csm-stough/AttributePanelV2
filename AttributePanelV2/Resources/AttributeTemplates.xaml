                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Attribute Name -->
            <TextBlock
                Grid.Column="1"
                Text="{Binding Alias}"
                VerticalAlignment="Center"/>
            <!-- Attribute Value: a small schematic sketch of the feature's actual shape (real
                 vertices, not to map scale/rotation) rather than raw coordinate text. Hovering
                 it pops up a larger version of the same drawing via the Border's ToolTip. -->
            <Border
                Grid.Column="2"
                Width="36"
                Height="36"
                HorizontalAlignment="Left"
                BorderBrush="#FF808080"
                BorderThickness="1"
                Background="Transparent">
                <Border.ToolTip>
                    <ToolTip>
                        <Border Width="200" Height="200" Padding="6">
                            <Path
                                Data="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ToolTip}, Converter={StaticResource GeometryThumbnailConverter}}"
                                Stretch="Uniform"
                                Fill="#331B75D6"
                                Stroke="#FF1B75D6"
                                StrokeThickness="1.2"
                                RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform ScaleY="-1"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                    </ToolTip>
                </Border.ToolTip>
                <Path
                    Data="{Binding Converter={StaticResource GeometryThumbnailConverter}}"
                    Stretch="Uniform"
                    Margin="3"
                    Fill="#331B75D6"
                    Stroke="#FF1B75D6"
                    StrokeThickness="1.2"
                    RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform ScaleY="-1"/>
                    </Path.RenderTransform>
                </Path>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="GUIDAttributeTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Dirty Indicator -->
            <TextBlock
                Grid.Column="0"
                Text="●"
                HorizontalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Attribute Name -->
            <TextBlock
                Grid.Column="1"
                Text="{Binding Alias}"
                VerticalAlignment="Center"/>
            <!-- Attribute Value -->
            <!-- A plain GUID field (unlike GlobalID) is treated as a possible foreign key
                 the "Go To" button asks Dockpane1ViewModel to treat this value as another
                 feature's GlobalID and jump to it if a match exists anywhere in the map. Reaches
                 up past this template's own DataContext (this attribute) to the Dockpane1View
                 UserControl's DataContext (Dockpane1ViewModel), since resolving the reference
                 needs the whole map, not just this one field. -->
            <DockPanel Grid.Column="2">
                <Button
                    DockPanel.Dock="Right"
                    Content="→"
                    Width="24"
                    Margin="4,0,0,0"
                    ToolTip="Select the feature this GUID references"
                    Command="{Binding DataContext.GoToReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding CurrentValue}"
                />
                <TextBlock
                    Text="{Binding CurrentValue, TargetNullValue=&lt;Null&gt;}"
                />
            </DockPanel>
        </Grid>
    </DataTemplate>

