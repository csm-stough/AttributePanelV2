                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <!-- Attribute Name -->
            <TextBlock
                Grid.Column="1"
                Text="{Binding Alias}"
                VerticalAlignment="Center"/>
            <!-- Attribute Value -->
            <ComboBox
                Grid.Column="2"
                SelectedValue="{Binding CurrentValue, Mode=TwoWay}"
                ItemsSource="{Binding DomainValues}"
                DisplayMemberPath="Value"
                SelectedValuePath="Key"
                IsEnabled="{Binding IsEditable}"
            >
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding Key, Converter={StaticResource VariesKeyToIsEnabledConverter}}"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </Grid>
    </DataTemplate>

